From cd929292a04803d9b2fe872437b494575c9a8314 Mon Sep 17 00:00:00 2001
From: ballgorrawe <253218482+ballgorrawe@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:19:58 +0700
Subject: [PATCH] B02 Cursed Altar can push Max HP to 0 or below

---
 scripts/core/run_state.gd | 12 ++++++++++--
 scripts/main.gd           |  6 ++++--
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/scripts/core/run_state.gd b/scripts/core/run_state.gd
index e910a15..e042c52 100644
--- a/scripts/core/run_state.gd
+++ b/scripts/core/run_state.gd
@@ -5,6 +5,7 @@ extends RefCounted
 
 const RESIST := 0.2          # damage multiplier when the foe resists that element (80% less)
 const MAX_HEARTS := 3
+const MIN_MAX_HP := 30.0       # the Cursed Altar can never take Max HP below this
 const COMBAT_DROP := 0.25       # chance a normal fight drops an item
 const LOOT_PARTNER_BIAS := 0.35 # chance loot is a recipe partner of something you own
 const ELITE_FROM_DAY := 2       # no Elite nodes on day 1
@@ -361,7 +362,7 @@ func max_hp() -> float:
 	var m := GameData.base_hp + mhp_mod + pv("hp")
 	for i in grid_items():
 		m += i.def().pass.hp
-	return m
+	return maxf(10.0, m)
 
 
 func regen() -> float:
@@ -811,7 +812,7 @@ func event_ok(k: String) -> bool:
 		"roulette":
 			return day >= 2
 		"altar":
-			return day >= 3 and (res > 0 or mhp > 40)
+			return day >= 3 and (res > 0 or altar_hp_ok())
 		"cauldron":
 			return items.filter(func(i): return not i.starter).size() >= 2
 	return true
@@ -1037,6 +1038,11 @@ func ev_brew(a: PItem, b: PItem) -> String:
 
 
 ## Cursed altar: a Legendary item for 10 Max HP forever, or for a Heart.
+## Paying with Max HP is only allowed while it stays at or above the floor.
+func altar_hp_ok() -> bool:
+	return mhp - 10 >= MIN_MAX_HP
+
+
 func ev_altar(i: int, pay: String) -> bool:
 	if event.get("done", false) or i < 0 or i >= event.offer.size():
 		return false
@@ -1046,6 +1052,8 @@ func ev_altar(i: int, pay: String) -> bool:
 		res -= 1
 		event.rew.append({"k": "heart", "v": -1})
 	else:
+		if not altar_hp_ok():
+			return false
 		mhp_mod -= 10
 		sync_hp()
 		event.rew.append({"k": "maxhp", "v": -10})
diff --git a/scripts/main.gd b/scripts/main.gd
index 4ba3e48..892c9f8 100644
--- a/scripts/main.gd
+++ b/scripts/main.gd
@@ -1882,9 +1882,11 @@ func _ev_altar(v: VBoxContainer) -> void:
 		tv.add_child(UI.wrap_lbl(GameData.describe_lines(id)[0], 15, Color("#e9e4ff")))
 		var br := UI.hbox(8)
 		var ii: int = i
-		br.add_child(UI.btn("-10 " + tr("Max HP"), func():
+		var mb := UI.btn("-10 " + tr("Max HP"), func():
 			run.ev_altar(ii, "hp")
-			render(), false, 16, "red"))
+			render(), false, 16, "red")
+		mb.disabled = not run.altar_hp_ok()
+		br.add_child(mb)
 		var hb := UI.btn("-1 ❤️", func():
 			run.ev_altar(ii, "heart")
 			render(), false, 16, "purple")
-- 
